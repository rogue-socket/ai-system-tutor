# Default: auto-detect text files, normalize line endings on commit.
* text=auto

# Unix-style scripts and configs — must be LF even on Windows.
*.sh        text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env*       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Windows-specific scripts — must be CRLF.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary blobs — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
